# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# n8n
infrastructure/n8n/.n8n/

# Homebridge -- persist/ holds the actual HomeKit pairing keypair and
# accessory identifiers, real credential material, not source.
# config.json's bridge.pin is the real HomeKit pairing PIN -- same
# .env/.env.example pattern as everywhere else in this project.
infrastructure/homekit_bridge/persist/
infrastructure/homekit_bridge/config.json
infrastructure/homekit_bridge/homebridge.log

# Runtime state (not source)
agents/*/.telegram_offset.json
agents/forex/.entry_exit_telegram_offset.json
agents/forex/.pending_trade_proposals.json
agents/fixera/.marketing_pending_posts.json
agents/fixera/.marketplace_price_regulation_seen.json

# Logs
*.log

# Local voice recordings (runtime artifacts, not source -- and
# potentially personal/sensitive audio)
shared/voice/.last_recording.wav
*.wav

# One-off scratch/debug scripts (superseded by tests/)
_tmp_verify_*.py

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
